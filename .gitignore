__pycache__/
*.pyc
.env

# Local Claude Code overrides stay local; the shared allowlist is tracked.
.claude/settings.local.json
!.claude/settings.json

# Per-cycle run logs from run-cycle.ps1 — local diagnostics only.
logs/

# Built output for the DSR deploy repo; publish.py pushes it there.
docs_dsr/

# Worktrees created by background sessions; never part of the repo.
.claude/worktrees/

# Reddit OAuth credentials; read-only, never committed.
.reddit-credentials.json

# Web analytics beacon tokens.
.analytics.json

# Cloudflare read-scoped API token and account id. ASK-HUMAN.md told him this
# file was already ignored; it was not, and cycles run `git add -A` against a
# public repo. Ignored before the token exists, which is the only safe order.
.cloudflare.json

# 23MB of raw MLB game logs; scripts/zero_k_shutouts.py regenerates it in ~6 min.
# The derived answer lives in scripts/zero_k_shutouts_result.json, which is tracked.
scripts/zero_k_shutouts_cache.json
