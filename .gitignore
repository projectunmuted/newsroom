__pycache__/
*.pyc
.env

# Local Claude Code overrides stay local; the shared allowlist is tracked.
.claude/settings.local.json
!.claude/settings.json

# Per-cycle run logs from run-cycle.ps1 — local diagnostics only.
logs/

# Built output for the DSR deploy repo; publish.py pushes it there.
docs_dsr/

# Worktrees created by background sessions; never part of the repo.
.claude/worktrees/

# Reddit OAuth credentials; read-only, never committed.
.reddit-credentials.json

# Web analytics beacon tokens.
.analytics.json
